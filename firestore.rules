rules_version = '2';
// SnakeX Cloud · workshop-safe Firestore rules.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{doc} {
      // The global leaderboard is publicly readable — anyone may WATCH it.
      allow read: if true;

      // Only signed-in users may POST a score, only as themselves,
      // and score must be an integer in a sane arcade range (anti-tamper).
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score < 1000000;

      // Scores are immutable — leaderboard entries can't be edited or
      // deleted by clients (trainer cleans up from the Firebase console).
      allow update, delete: if false;
    }
  }
}
